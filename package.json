{
  "name": "google-tasks-pro",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "launch:dev": "tauri dev",
    "build:app": "tauri build --bundles app",
    "build:apk": "JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home ANDROID_HOME=$HOME/Library/Android/sdk NDK_HOME=$HOME/Library/Android/sdk/ndk/26.3.11579264 tauri android build --apk --target aarch64 --target armv7",
    "build:dmg": "tauri build --bundles app && mkdir -p src-tauri/target/release/bundle/dmg && hdiutil create -volname 'Google Tasks Pro' -srcfolder 'src-tauri/target/release/bundle/macos/Google Tasks Pro.app' -ov -format UDZO 'src-tauri/target/release/bundle/dmg/Google Tasks Pro_2.2.0_aarch64.dmg'",
    "screenshot": "bash scripts/capture.sh",
    "screenshot:showcase": "node scripts/generate-showcase.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fabianlars/tauri-plugin-oauth": "^2.0.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "axios": "^1.21.0",
    "crypto-js": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recoil": "^0.7.7",
    "recoil-nexus": "^0.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.19"
  }
}
