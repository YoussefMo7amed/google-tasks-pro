{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Google Tasks Pro",
    "version": "../package.json"
  },
  "tauri": {
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "updater": {
      "active": false
    },
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "https://tasks.googleapis.com/**",
          "https://oauth2.googleapis.com/**",
          "https://www.googleapis.com/**",
          "https://generativelanguage.googleapis.com/**",
          "https://api.openai.com/**",
          "https://api.anthropic.com/**",
          "https://api.groq.com/**",
          "https://openrouter.ai/**",
          "http://localhost/**",
          "http://127.0.0.1/**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      },
      "globalShortcut": {
        "all": true 
      },
      "dialog": {
        "all": false,
        "ask": true,
        "confirm": true,
        "message": true,
        "open": false,
        "save": false
      },
      "notification": {
        "all": true 
      },
      "fs": {
        "all": true,
        "scope": [
          "$APPDATA/codad5.google.task/**",
          "$APPDATA/codad5.google.task/*",
          "$APPDATA/codad5.google.task",
          "$APPLOCALDATA/codad5.google.task/**",
          "$APPLOCALDATA/codad5.google.task/*",
          "$APPLOCALDATA/codad5.google.task"
        ]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "category": "Productivity",
      "identifier": "codad5.google.task",
      "copyright": "Copyright © 2026 Youssef Mohamed",
      "publisher": "Youssef Mohamed",
      "resources": [],
      "shortDescription": "Google Tasks Pro desktop client",
      "longDescription": "Google Tasks Pro desktop client with AI Copilot, Eisenhower Matrix, Calendar, and Offline Sync",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      },
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "deb": {
        "depends": []
      },
      "externalBin": []
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tasks.googleapis.com https://oauth2.googleapis.com https://www.googleapis.com https://generativelanguage.googleapis.com https://api.openai.com https://api.anthropic.com https://api.groq.com https://openrouter.ai http://localhost:* http://127.0.0.1:*;"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Google Tasks Pro",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  }
}
