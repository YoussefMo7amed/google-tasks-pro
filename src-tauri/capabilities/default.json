{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default cross-platform capabilities for Google Tasks Pro",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-hide",
    "core:app:default",
    "core:webview:default",
    "core:image:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "notification:default",
    "shell:allow-open",
    "store:default",
    "log:default",
    "os:default",
    "deep-link:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/codad5.google.task/**" },
        { "path": "$APPDATA/codad5.google.task/*" },
        { "path": "$APPDATA/codad5.google.task" },
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA/*" },
        { "path": "$APPDATA" },
        { "path": "$DOWNLOAD/codad5.google.task/**" },
        { "path": "$DOWNLOAD/codad5.google.task/*" },
        { "path": "$DOWNLOAD/codad5.google.task" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/*" },
        { "path": "$DOWNLOAD" },
        { "path": "$APPLOCALDATA/codad5.google.task/**" },
        { "path": "$APPLOCALDATA/codad5.google.task/*" },
        { "path": "$APPLOCALDATA/codad5.google.task" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$APPLOCALDATA/*" },
        { "path": "$APPLOCALDATA" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    }
  ]
}
