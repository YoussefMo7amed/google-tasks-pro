  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-specific capabilities for Google Tasks Pro (global shortcuts and OAuth local server)",
  "windows": [
    "main"
  ],
  "platforms": [
